# Server-only. Lets customer-triggered order actions read the protected email
# recipients configured in Admin → Settings. Never use a NEXT_PUBLIC_ prefix.
# SUPABASE_SECRET_KEY=sb_secret_your_key_here


# ---- Transactional order email + email marketing ----
# Create a free account at resend.com, verify your sending domain, then:
# RESEND_API_KEY=re_your_key_here
# ORDER_FROM_EMAIL=Grainbuds <orders@grainbuds.de>
# MARKETING_FROM_EMAIL=Grainbuds <hello@yourdomain.de>
# Optional fallback until recipients are saved in Admin → Settings:
